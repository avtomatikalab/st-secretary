# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
dist/
build/
*.egg-info/

# Реальные данные соревнований НИКОГДА не попадают в репозиторий:
# заявки, протоколы с ФИО, договоры, паспортные данные, выгрузки SI.
# Для тестов используются только обезличенные копии в tests/fixtures/.
*.xls
*.xlsx
*.xlsm
*.doc
*.docx
*.pdf
*.csv
!tests/fixtures/*.csv
# Выдуманный бланк делегации из двух листов (Правки, п. 29) — без реальных данных.
!tests/fixtures/class_sheets_application.xls
# Инструкция секретаря — снимки учебного соревнования с выдуманными данными (tools/make_manual.py).
!docs/Инструкция секретаря.docx
!docs/Инструкция секретаря.pdf
reports/
local/
# Папка с соревнованиями, которые ведутся в программе (карточки, заявки с ФИО и датами рождения).
данные/
# Резервные копии соревнований (zip тех же данных) — рядом с папкой «данные».
Резервные копии/
# Журнал программы (journal.py) — рядом с «данными», только на этом компьютере.
Журнал/
.claude/
.env
*.env

# Редакторы и ОС
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
